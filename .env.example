# NovelBridge — Environment Variables
# Copy this file to .env and fill in your API keys

# ── Translation providers ──────────────────────────────────────────────────────
# TokenRouter (OpenAI-compatible) — Get a key at https://tokenrouter.com
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here
TOKENROUTER_MODEL=deepseek/deepseek-v4-pro-0813-free
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# OrcaRouter (OpenAI-compatible) — Get a key at https://orcarouter.ai
ORCAROUTER_API_KEY=your_orcarouter_api_key_here
ORCAROUTER_MODEL=deepseek/deepseek-v4-flash-free
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1


# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b



# ── App settings ──────────────────────────────────────────────────────────────
# Max concurrent scrape/translate pipelines
MAX_CONCURRENT_JOBS=3

# FastAPI server port (for Flutter phone client)
API_PORT=8000

# Database path (relative to project root)
DB_PATH=data/novelbridge.db

# Output folder for generated EPUBs
OUTPUT_DIR=output
