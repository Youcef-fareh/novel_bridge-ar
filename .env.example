# NovelBridge — Environment Variables
# Copy this file to .env and fill in your API keys

# ── Translation providers ──────────────────────────────────────────────────────
# TokenRouter (OpenAI-compatible) — Get a key at https://tokenrouter.com
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=deepseek/deepseek-v4-pro-0813-free
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# OrcaRouter (OpenAI-compatible) — Get a key at https://orcarouter.ai
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=deepseek/deepseek-v4-flash-free
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1


# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com

# xAI Grok (OpenAI-compatible)
XAI_API_KEY=
GROK_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1



# ── App settings ──────────────────────────────────────────────────────────────
# Persistent scheduler worker count and per-origin running-job cap
MAX_CONCURRENT_JOBS=3
MAX_CONCURRENT_PER_DOMAIN=2
MAX_ATTEMPTS=5
# HTTP scrape timeout and minimum accepted chapter text length
REQUEST_TIMEOUT=30
MIN_CHAPTER_CHARS=50
# Translation provider timeout (seconds)
TRANSLATOR_REQUEST_TIMEOUT=900
# Calibre conversion is optional; local `ebook-convert` enables pdf/azw3/mobi/docx
CALIBRE_COMMAND=ebook-convert
CALIBRE_API_ENABLED=false
CALIBRE_API_URL=
CALIBRE_API_FALLBACK_TO_LOCAL=true
# Queue polling interval in seconds
SCHEDULER_POLL_SECONDS=0.5

# Maximum total size of eligible generated EPUBs before oldest files are removed.
# Only EPUBs at least seven days old are eligible for cleanup.
OUTPUT_MAX_MB=2048

# FastAPI server port (for Flutter phone client)
API_PORT=8000

# Optional external lightnovel-crawler checkout and source adapters.
# LNCRAWL_ROOT=C:/path/to/lightnovel-crawler-dev
# LNCRAWL_SOURCES_ROOT=C:/path/to/lightnovel-crawler-sources

# Database path (relative to project root)
DB_PATH=data/novelbridge.db

# Output folder for generated EPUBs
OUTPUT_DIR=output

# Google Drive OAuth desktop client JSON and cached login token
# Download the OAuth client file from Google Cloud and place it at this path.
GOOGLE_DRIVE_CREDENTIALS_FILE=config/google_client_secret.json
# GOOGLE_DRIVE_TOKEN_FILE=C:/Users/your-name/.novelbridge/google_drive_token.json
