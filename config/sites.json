{
  "wuxiaspot": {
    "base_url": "https://www.wuxiaspot.com",
    "request_delay_min": 0.2,
    "request_delay_max": 0.6,
    "use_curl_cffi": true,
    "respect_robots_txt": false
  },
  "novelfire": {
    "base_url": "https://novelfire.net",
    "selectors": {
      "novel_title": "h1.novel-title, .book-name h1, .novel-info h1",
      "novel_author": ".author-content a, .novel-author .author-name",
      "novel_cover": ".book-img img, .novel-cover img",
      "novel_description": ".summary__content, .novel-description",
      "chapter_list": ".wp-manga-chapter a, .chapter-item a, #chapterlist li a",
      "chapter_title": ".chapter-title, h2.active, h1.chapter-title",
      "chapter_text": "#chapter-container, .chapter-content, .text-left"
    },
    "request_delay_min": 0.1,
    "request_delay_max": 0.35,
    "use_curl_cffi": true,
    "respect_robots_txt": false
  },
  "wtrlab": {
    "base_url": "https://wtr-lab.com",
    "selectors": {
      "novel_title": "h1.story-title, .story-name",
      "novel_author": ".story-author a",
      "novel_cover": ".story-cover img, .story-image img",
      "novel_description": ".story-desc, .story-description",
      "chapter_list": ".chapter-list a, .chapter-item a",
      "chapter_title": "h1.chapter-title, .chapter-name",
      "chapter_text": ".chapter-content, .story-part, #chapter-container"
    },
    "request_delay_min": 1.0,
    "request_delay_max": 3.0,
    "use_curl_cffi": true,
    "respect_robots_txt": false
  },
  "novelphoenix": {
    "base_url": "https://novelphoenix.com",
    "selectors": {
      "novel_title": "h1",
      "novel_author": ".author, .novel-info .author",
      "novel_cover": ".cover img, .novel-info img",
      "novel_description": ".summary, .description, .content",
      "chapter_list": ".chapter-list li a, .chapter-list a",
      "chapter_title": "h1, .chapter-title",
      "chapter_text": "#chapter-container, .chapter-content"
    },
    "request_delay_min": 0.1,
    "request_delay_max": 0.35,
    "use_curl_cffi": true,
    "respect_robots_txt": false
  },
  "galaxynovels": {
    "base_url": "https://galaxynovels.com",
    "selectors": {
      "novel_title": "h1, .wor-single-title",
      "novel_author": ".author, .wor-author a",
      "novel_cover": ".wor-single-thumb img, .wor-single-cover img, .wp-post-image",
      "novel_description": ".wor-single-summary__text, .description",
      "chapter_list": ".wor-novel-chapters-list a, .wor-novel-chapter-item a",
      "chapter_title": "h1, .wor-chapter-title",
      "chapter_text": ".wor-chapter-body, .chapter-content, #chapter-container, article"
    },
    "request_delay_min": 0.8,
    "request_delay_max": 2.5,
    "use_curl_cffi": true,
    "respect_robots_txt": false
  },
  "lightnovelpub": {
    "base_url": "https://lightnovelpub.me",
    "selectors": {
      "novel_title": ".m-desc .tit, h1",
      "novel_author": ".m-book1 .item [title=Author] + .right a, .m-book1 .item .right a",
      "novel_cover": ".m-book1 .pic img, .m-book1 img",
      "novel_description": ".m-desc .inner, .abstract + .txt",
      "chapter_list": ".m-newest2 .ul-list5 a.con",
      "chapter_list_next": ".index-container-btn",
      "chapter_text": ".read-content, .txt, .chapter-content, #chapter-container, article"
    },
    "request_delay_min": 0.8,
    "request_delay_max": 2.5,
    "use_curl_cffi": true,
    "respect_robots_txt": false
  },
  "ranovel": {
    "base_url": "https://ranovel.com",
    "selectors": {
      "novel_title": ".post-title, h1.entry-title, h1",
      "novel_author": ".post-content_item .summary-content a, .author-content a, .post-content_item",
      "novel_cover": ".summary_image img, .summary_image a img, .profile-manga .summary_image img",
      "novel_description": ".description-summary, .summary_content, .summary_content p",
      "chapter_list": "#manga-chapters-holder .wp-manga-chapter a",
      "chapter_list_next": ".pagination a.next, .nav-links .nav-next a, a[rel=next]",
      "chapter_text": ".reading-content, .text-left, .entry-content, #chapter-container"
    },
    "request_delay_min": 0.8,
    "request_delay_max": 2.5,
    "use_curl_cffi": true,
    "respect_robots_txt": false
  }
}
